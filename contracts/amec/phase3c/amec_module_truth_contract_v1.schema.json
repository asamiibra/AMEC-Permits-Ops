{
  "$defs": {
    "assertion": {
      "additionalProperties": false,
      "properties": {
        "architecture_invariant_ref_if_applicable": {
          "pattern": "^EVID_[A-Z0-9_]+$",
          "type": [
            "string",
            "null"
          ]
        },
        "assertion_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]+$",
          "type": "string"
        },
        "basis_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "basis_type": {
          "enum": [
            "OWNER_DECISION",
            "EXECUTABLE_REPOSITORY_EVIDENCE",
            "VERIFIED_STAGE1R_EVIDENCE",
            "CANONICAL_ARCHITECTURE_INVARIANT",
            "MIXED"
          ]
        },
        "canonical_value_or_rule": {
          "minLength": 1,
          "type": "string"
        },
        "domain": {
          "pattern": "^(M[1-7]|FINANCE|MASTER_CONTENT|REPORTS)$",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^EVID_[A-Z0-9_]+$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "notes": {
          "minLength": 1,
          "type": "string"
        },
        "owner_decision_ref_if_applicable": {
          "pattern": "^OD-[0-9]{3}$",
          "type": [
            "string",
            "null"
          ]
        },
        "repository_ref_if_applicable": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_state": {
          "minLength": 1,
          "type": "string"
        },
        "stage1r_ref_if_applicable": {
          "pattern": "^EVID_STAGE1R_[A-Z0-9_]+$",
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "enum": [
            "CANONICAL_RULE",
            "CANONICAL_OR_EXPLICITLY_UNCERTAIN",
            "EXPLICIT_UNCERTAINTY"
          ]
        },
        "supersedes_if_applicable": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]+$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "truth_dimension": {
          "minLength": 1,
          "type": "string"
        },
        "truth_type": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "assertion_id",
        "domain",
        "truth_dimension",
        "truth_type",
        "canonical_value_or_rule",
        "state",
        "basis_type",
        "basis_refs",
        "evidence_ids",
        "owner_decision_ref_if_applicable",
        "repository_ref_if_applicable",
        "stage1r_ref_if_applicable",
        "architecture_invariant_ref_if_applicable",
        "supersedes_if_applicable",
        "source_state",
        "notes"
      ],
      "type": "object"
    },
    "coverageCell": {
      "additionalProperties": false,
      "properties": {
        "basis_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "basis_type": {
          "enum": [
            "OWNER_DECISION",
            "EXECUTABLE_REPOSITORY_EVIDENCE",
            "VERIFIED_STAGE1R_EVIDENCE",
            "CANONICAL_ARCHITECTURE_INVARIANT",
            "MIXED"
          ]
        },
        "cell_id": {
          "pattern": "^(M[1-7]|FINANCE|MASTER_CONTENT|REPORTS)-[0-9]{2}$",
          "type": "string"
        },
        "contract_assertion_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]+$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "coverage_claim": {
          "minLength": 1,
          "type": "string"
        },
        "dimension": {
          "minLength": 1,
          "type": "string"
        },
        "dimension_order": {
          "maximum": 25,
          "minimum": 1,
          "type": "integer"
        },
        "domain": {
          "minLength": 1,
          "type": "string"
        },
        "domain_code": {
          "pattern": "^(M[1-7]|FINANCE|MASTER_CONTENT|REPORTS)$",
          "type": "string"
        },
        "evidence_gap_refs": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]+$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "evidence_ids": {
          "items": {
            "pattern": "^EVID_[A-Z0-9_]+$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "owner_decision_refs": {
          "items": {
            "pattern": "^OD-[0-9]{3}$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "requirement_id": {
          "pattern": "^MT-(M[1-7]|FINANCE|MASTER_CONTENT|REPORTS)-[0-9]{2}$",
          "type": "string"
        },
        "result": {
          "enum": [
            "PASS",
            "NOT_APPLICABLE"
          ]
        },
        "semantic_validation_method": {
          "minLength": 1,
          "type": "string"
        },
        "truth_state": {
          "enum": [
            "CANONICAL_RULE",
            "CANONICAL_OR_EXPLICITLY_UNCERTAIN",
            "EXPLICIT_UNCERTAINTY"
          ]
        }
      },
      "required": [
        "cell_id",
        "requirement_id",
        "domain_code",
        "domain",
        "dimension_order",
        "dimension",
        "truth_state",
        "basis_type",
        "basis_refs",
        "evidence_ids",
        "contract_assertion_ids",
        "owner_decision_refs",
        "evidence_gap_refs",
        "coverage_claim",
        "semantic_validation_method",
        "result"
      ],
      "type": "object"
    },
    "evidenceRecord": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^([a-f0-9]{40}|[a-f0-9]{64}|ARCHITECTURE_INVARIANT)$",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "sha256"
      ],
      "type": "object"
    },
    "id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_-]+$",
      "type": "string"
    },
    "ownerDecision": {
      "additionalProperties": false,
      "properties": {
        "affected_assertion_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]+$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "affected_domains": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "current_evidence": {
          "items": {
            "pattern": "^EVID_[A-Z0-9_]+$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "decision_id": {
          "pattern": "^OD-[0-9]{3}$",
          "type": "string"
        },
        "default": {
          "const": "NONE"
        },
        "dependency_family": {
          "minLength": 1,
          "type": "string"
        },
        "downstream_blocker": {
          "minLength": 1,
          "type": "string"
        },
        "owner_status": {
          "enum": [
            "PENDING",
            "OWNER_CONFIRMED",
            "AMBIGUOUS",
            "RECOMMENDED_NOT_CONFIRMED"
          ]
        },
        "question_exact": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "decision_id",
        "dependency_family",
        "question_exact",
        "affected_domains",
        "affected_assertion_ids",
        "owner_status",
        "current_evidence",
        "downstream_blocker",
        "default"
      ],
      "type": "object"
    },
    "protectedAuthority": {
      "additionalProperties": false,
      "properties": {
        "assertion_ids": {
          "items": {
            "pattern": "^AUTH-[a-z0-9_]+$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "authority_id": {
          "pattern": "^[a-z][a-z0-9_]+$",
          "type": "string"
        },
        "display_name": {
          "minLength": 1,
          "type": "string"
        },
        "domain_code": {
          "pattern": "^(M[1-7]|FINANCE|MASTER_CONTENT|REPORTS)$",
          "type": "string"
        },
        "human_required": {
          "const": true
        },
        "policy_bound": {
          "const": true
        },
        "protected": {
          "const": true
        }
      },
      "required": [
        "authority_id",
        "display_name",
        "domain_code",
        "human_required",
        "protected",
        "policy_bound",
        "assertion_ids"
      ],
      "type": "object"
    },
    "truthDimension": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "order": {
          "maximum": 25,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "order",
        "name"
      ],
      "type": "object"
    },
    "truthDomain": {
      "additionalProperties": false,
      "properties": {
        "classifier_primary_tag": {
          "enum": [
            "INTAKE_OPPORTUNITY_BD",
            "CONTRACT_MOBILIZATION",
            "DESIGN_TECHNICAL_DELIVERY",
            "REGULATORY_SUBMISSIONS",
            "CONSTRUCTION_POST_APPROVAL",
            "COMPLETION_AS_BUILT",
            "HANDOVER_CLOSEOUT",
            "FINANCE",
            null
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "code": {
          "pattern": "^(M[1-7]|FINANCE|MASTER_CONTENT|REPORTS)$",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "code",
        "name",
        "classifier_primary_tag"
      ],
      "type": "object"
    }
  },
  "$id": "AMEC_MODULE_TRUTH_CONTRACT_V1_SCHEMA",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
