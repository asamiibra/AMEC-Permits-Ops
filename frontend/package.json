{
  "name": "proposalops-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest",
    "browser-e2e": "playwright test",
    "browser-real-stack": "playwright test -c playwright.real-stack.config.ts",
    "browser-edge": "playwright test -c playwright.edge.config.ts",
    "ui-conformance:prepare": "node scripts/ui-conformance-audit.mjs",
    "ui-conformance": "npm run ui-conformance:prepare && playwright test browser-e2e/ui-conformance.spec.ts"
  },
  "dependencies": {
    "@azure/msal-browser": "5.18.0",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1"
  }
}
