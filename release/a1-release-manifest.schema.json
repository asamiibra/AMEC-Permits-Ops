{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["stage", "repository", "source_sha", "database", "entra", "azure", "safety"],
  "properties": {
    "stage": {"enum": ["PREDEPLOY", "DEPLOYED"]},
    "repository": {"type": "string", "const": "asamiibra/AMEC-Permits-Ops"},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "frontend": {"anyOf": [{"$ref": "#/$defs/image"}, {"type": "null"}]},
    "backend": {"anyOf": [{"$ref": "#/$defs/image"}, {"type": "null"}]},
    "webjobs": {"anyOf": [{"$ref": "#/$defs/webjobs"}, {"type": "null"}]},
    "database": {
      "type": "object",
      "required": ["engine", "major", "migration_head"],
      "properties": {
        "engine": {"const": "azure_sql"},
        "major": {"const": 16},
        "migration_head": {"const": "baseline_phase4_v36_azure_sql"}
      },
      "additionalProperties": false
    },
    "entra": {
      "type": "object",
      "required": ["required_scope", "requested_access_token_version"],
      "properties": {
        "tenant_id": {"anyOf": [{"$ref": "#/$defs/guid"}, {"type": "null"}]},
        "api_client_id": {"anyOf": [{"$ref": "#/$defs/guid"}, {"type": "null"}]},
        "web_client_id": {"anyOf": [{"$ref": "#/$defs/guid"}, {"type": "null"}]},
        "required_scope": {"const": "access_as_user"},
        "requested_access_token_version": {"const": 2}
      },
      "additionalProperties": false
    },
    "azure": {
      "type": "object",
      "required": ["subscription_id", "region"],
      "properties": {
        "subscription_id": {"const": "61080f8b-16cb-4abc-bb8c-5d8e59ab15bf"},
        "region": {"const": "qatarcentral"},
        "resource_group": {"type": ["string", "null"], "minLength": 1},
        "frontend_site": {"type": ["string", "null"], "minLength": 1},
        "backend_site": {"type": ["string", "null"], "minLength": 1},
        "sql_server": {"type": ["string", "null"], "minLength": 1},
        "sql_database": {"type": ["string", "null"], "minLength": 1}
      },
      "additionalProperties": false
    },
    "safety": {
      "type": "object",
      "required": ["app_env", "synthetic_only", "real_data_allowed", "storage_provider", "synology_mode", "azure_to_synology"],
      "properties": {
        "app_env": {"const": "AZURE-PREPROD"},
        "synthetic_only": {"const": true},
        "real_data_allowed": {"const": false},
        "storage_provider": {"const": "mock"},
        "synology_mode": {"const": "SYNTHETIC"},
        "azure_to_synology": {"const": false}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": ["object", "null"],
      "properties": {
        "source_ci_run": {"type": ["string", "null"]},
        "iac_ci_run": {"type": ["string", "null"]},
        "deployment_run": {"type": ["string", "null"]},
        "browser_e2e_run": {"type": ["string", "null"]},
        "restore_run": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"stage": {"const": "DEPLOYED"}}},
      "then": {
        "required": ["frontend", "backend", "webjobs", "evidence"],
        "properties": {
          "frontend": {"$ref": "#/$defs/image"},
          "backend": {"$ref": "#/$defs/image"},
          "webjobs": {"$ref": "#/$defs/webjobs"},
          "evidence": {
            "type": "object",
            "required": ["source_ci_run", "iac_ci_run", "deployment_run", "browser_e2e_run", "restore_run"]
          },
          "entra": {
            "required": ["tenant_id", "api_client_id", "web_client_id"]
          },
          "azure": {
            "required": ["resource_group", "frontend_site", "backend_site", "sql_server", "sql_database"]
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "guid": {"type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"},
    "image": {
      "type": "object",
      "required": ["image_reference", "image_digest", "release_sha", "base_image_digest"],
      "properties": {
        "image_reference": {"type": "string", "pattern": "^.+@sha256:[0-9a-f]{64}$"},
        "image_digest": {"$ref": "#/$defs/sha256"},
        "release_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "base_image_digest": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "webjobs": {
      "type": "object",
      "required": ["worker_package_sha256"],
      "properties": {
        "worker_package_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  }
}
