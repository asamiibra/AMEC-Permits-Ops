param sqlAdministratorPassword = readEnvironmentVariable('PROPOSALOPS_OWNER_TEST_SQL_PASSWORD', 'REQUIRED_AT_DEPLOYMENT')
param sqlServerName = 'sql-proposalops-owner-test-uaenorth'
param sqlDatabaseName = 'proposalops-owner-test'
param acrName = 'acrproposalopsowner'
