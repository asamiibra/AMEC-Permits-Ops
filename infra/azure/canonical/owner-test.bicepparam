param apiImage = readEnvironmentVariable('PROPOSALOPS_OWNER_TEST_API_IMAGE', 'REQUIRED_AT_DEPLOYMENT')
param workerImage = readEnvironmentVariable('PROPOSALOPS_OWNER_TEST_WORKER_IMAGE', 'REQUIRED_AT_DEPLOYMENT')
param migrationImage = readEnvironmentVariable('PROPOSALOPS_OWNER_TEST_MIGRATION_IMAGE', 'REQUIRED_AT_DEPLOYMENT')
