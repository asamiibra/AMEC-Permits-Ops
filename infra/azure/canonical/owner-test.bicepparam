param bridgeTenantId = readEnvironmentVariable('PROPOSALOPS_OWNER_TEST_BRIDGE_TENANT_ID', 'REQUIRED_AT_DEPLOYMENT')
param bridgeClientId = readEnvironmentVariable('PROPOSALOPS_OWNER_TEST_BRIDGE_CLIENT_ID', 'REQUIRED_AT_DEPLOYMENT')
param bridgeAudience = readEnvironmentVariable('PROPOSALOPS_OWNER_TEST_BRIDGE_AUDIENCE', 'REQUIRED_AT_DEPLOYMENT')
param entraApiClientId = readEnvironmentVariable('PROPOSALOPS_OWNER_TEST_API_CLIENT_ID', 'REQUIRED_AT_DEPLOYMENT')
param entraWebClientId = readEnvironmentVariable('PROPOSALOPS_OWNER_TEST_WEB_CLIENT_ID', 'REQUIRED_AT_DEPLOYMENT')
param databaseUrl = readEnvironmentVariable('PROPOSALOPS_OWNER_TEST_DATABASE_URL', 'REQUIRED_AT_DEPLOYMENT')
